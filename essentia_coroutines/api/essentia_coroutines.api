final class TopicMetrics {
  final int delivered;
  final int dropped;
  final int failed;
  final int groups;
  final int published;
  final int queueDepth;
  final int subscribers;
  String toString();
}

final class TopicNotDeclaredError extends ArgumentError {
  final Set<String> declared;
  final String topicName;
}

final class TopicTypeMismatchError extends ArgumentError {
  final Type declared;
  final Type requested;
  final String topicName;
}

Future<Never> awaitCancellation();

Stream<R> combine<T, R>(Iterable<Stream<T>> streams, R Function(List<T>) transform);

Future<R> coroutineScope<R>(FutureOr<R> Function(CoroutineScope) block);

CoroutineContext currentCoroutineContext();

Principal? currentPrincipal();

Future<void> delay(Duration duration);

void ensureActive();

EventBus eventBus(void Function(EventBusBuilder) block);

void handleCoroutineException(CoroutineContext context, Object error, StackTrace stackTrace, {Zone? zone});

bool isCurrentCancellation(Object error);

CoroutineScope mainScope();

Principal requirePrincipal();

R runAsPrincipal<R>(Principal principal, R Function() body);

R runWithContext<R>(CoroutineContext added, R Function() body);

Future<R> select<R>(void Function(SelectBuilder<R>) block);

Future<R> selectUnbiased<R>(void Function(SelectBuilder<R>) block);

Future<R> supervisorScope<R>(FutureOr<R> Function(CoroutineScope) block);

List<Object> suppressedExceptionsOf(Object error);

Future<T> suspendCancellableCoroutine<T>(void Function(CancellableContinuation<T>) block);

Future<R> withContext<R>(CoroutineContext context, FutureOr<R> Function(CoroutineScope) block);

Future<R> withTimeout<R>(Duration timeout, FutureOr<R> Function(CoroutineScope) block);

Future<R?> withTimeoutOrNull<R>(Duration timeout, FutureOr<R> Function(CoroutineScope) block);

Future<void> yieldNow();

library package:essentia_coroutines/testing.dart

final class FakeShutdownHost implements ShutdownHost {
  FakeShutdownHost();
  List<int> get exits;
  bool get isWatched;
  void exit(int code);
  void raise(ShutdownSignal signal);
  Stream<ShutdownSignal> watch();
}

final class StandardTestDispatcher extends TestDispatcher {
  final String? name;
  final TestScheduler scheduler;
  StandardTestDispatcher({TestScheduler? scheduler, String? name});
  void dispatch(CoroutineContext context, Zone zone, void Function() block);
  CoroutineDispatcher limitedParallelism(int parallelism);
  String toString();
}

abstract class TestDispatcher extends CoroutineDispatcher {
  const TestDispatcher();
  abstract TestScheduler get scheduler;
}

final class TestScheduler extends Scheduler implements TimeSource, Clock, VirtualTime {
  final Instant start;
  TestScheduler({Instant? start});
  Clock get clock;
  Duration get currentTime;
  int get pendingTasks;
  TimeSource get timeSource;
  Zone get zone;
  Future<void> advanceTimeBy(Duration duration);
  Future<void> advanceUntilIdle();
  TimeMark markNow();
  Instant now();
  Duration read();
  R run<R>(R Function() body);
  Future<void> runCurrent();
  ScheduledTask schedule(Duration delay, void Function() action);
  String toString();
}

abstract interface class TestScope implements CoroutineScope {
  abstract CoroutineScope get backgroundScope;
  abstract TestScheduler get testScheduler;
}

extension TestScopeTime on TestScope {
  Duration get currentTime;
  TimeSource get testTimeSource;
  void advanceTimeBy(Duration duration);
  void advanceUntilIdle();
  void runCurrent();
}

final class UncompletedCoroutinesError extends AssertionError {
  UncompletedCoroutinesError(String message);
  String toString();
}

final class UnconfinedTestDispatcher extends TestDispatcher {
  final String? name;
  final TestScheduler scheduler;
  UnconfinedTestDispatcher({TestScheduler? scheduler, String? name});
  void dispatch(CoroutineContext context, Zone zone, void Function() block);
  bool isDispatchNeeded(CoroutineContext context);
  CoroutineDispatcher limitedParallelism(int parallelism);
  String toString();
}

Future<void> runTest(FutureOr<void> Function(TestScope) body, {CoroutineContext context = CoroutineContext.empty, Duration timeout = const Duration(seconds: 60)});
